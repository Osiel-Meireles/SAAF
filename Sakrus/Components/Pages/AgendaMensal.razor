@page "/agenda"
@attribute [Authorize]
@using MudBlazor
@using Sakrus.Core.Models
@using Sakrus.Services
@inject AgendaService AgendaService

<PageTitle>Agenda de Atendimentos - Sakrus</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Agenda do Cemitério</MudText>

<MudGrid>
    <MudItem xs="12" md="5" lg="4">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">Selecione uma Data</MudText>
            <MudDatePicker @bind-Date="dataSelecionada" Label="Data do Evento" PickerVariant="PickerVariant.Static" Elevation="0" Rounded="true" Class="mud-elevation-0 border-solid border-1 mud-border-lines-default rounded-lg" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7" lg="8">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <div class="d-flex align-center gap-3 mb-4">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">Eventos do Dia</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(dataSelecionada?.ToString("dd 'de' MMMM 'de' yyyy") ?? "Selecione uma data")</MudText>
                </div>
            </div>

            @if (dataSelecionada == null)
            {
                <MudAlert Severity="Severity.Info">Por favor, selecione uma data no calendário ao lado.</MudAlert>
            }
            else if (isLoading)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (eventos.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mt-4">
                    Nenhum sepultamento ou exumação marcado para este dia.
                </MudAlert>
            }
            else
            {
                <MudTable Items="eventos" Dense="false" Hover="true" Elevation="0" Striped="true" Class="mt-4">
                    <HeaderContent>
                        <MudTh>Horário</MudTh>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Falecido</MudTh>
                        <MudTh>Local</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Horário">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.Horario.ToString(@"hh\:mm")</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Tipo">
                            @if (context.TipoEvento == "Sepultamento")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Sepultamento</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Exumação</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Falecido">
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.FalecidoNome</MudText>
                        </MudTd>
                        <MudTd DataLabel="Local">@context.Local</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private DateTime? _dataSelecionada = DateTime.Today;
    private DateTime? dataSelecionada
    {
        get => _dataSelecionada;
        set
        {
            if (_dataSelecionada != value)
            {
                _dataSelecionada = value;
                _ = CarregarAgendaAsync();
            }
        }
    }

    private List<AgendaEvento> eventos = new();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAgendaAsync();
    }

    private async Task CarregarAgendaAsync()
    {
        if (_dataSelecionada == null)
        {
            eventos.Clear();
            return;
        }

        isLoading = true;
        StateHasChanged();

        eventos = await AgendaService.ObterEventosPorDataAsync(_dataSelecionada.Value);

        isLoading = false;
        StateHasChanged();
    }
}
