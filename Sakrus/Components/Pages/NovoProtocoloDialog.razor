@using Sakrus.Core.Entities
@using Sakrus.Infrastructure.Data
@using Sakrus.Services.Documentos
@using Microsoft.EntityFrameworkCore
@inject IProtocoloService ProtocoloService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.FolderShared" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Novo Protocolo</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="formValido">
            <MudGrid>
                <MudItem xs="12">
                    <MudAutocomplete T="Responsavel" Label="Responsável" @bind-Value="responsavel"
                                     SearchFunc="@PesquisarResponsaveis" ToStringFunc="@FormatarResponsavel"
                                     MinCharacters="2" MaxItems="15" Required="true" RequiredError="Responsável é obrigatório" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Assunto" @bind-Value="assuntoId" Required="true" RequiredError="Assunto é obrigatório">
                        @foreach (var assunto in assuntos)
                        {
                            <MudSelectItem T="int?" Value="@assunto.Id">@assunto.Nome</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="Jazigo" Label="Jazigo (opcional)" @bind-Value="jazigo"
                                     SearchFunc="@PesquisarJazigos" ToStringFunc="@(j => j?.CodigoIdentificador)"
                                     MinCharacters="2" MaxItems="15" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data de abertura" @bind-Date="dataAbertura" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Observação" @bind-Value="observacao" Lines="3" MaxLength="1000" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="@salvando">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar" Disabled="@salvando">
            @if (salvando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;
    private bool formValido;
    private bool salvando;
    private Responsavel? responsavel;
    private int? assuntoId;
    private Jazigo? jazigo;
    private DateTime? dataAbertura;
    private string observacao = "";
    private List<AssuntoProtocolo> assuntos = new();

    protected override async Task OnInitializedAsync()
    {
        dataAbertura = DateTime.Today;
        using var db = await DbFactory.CreateDbContextAsync();
        assuntos = await db.AssuntosProtocolo
            .Where(a => a.Ativo)
            .OrderBy(a => a.Nome)
            .ToListAsync();
    }

    private async Task<IEnumerable<Responsavel>> PesquisarResponsaveis(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor) || valor.Length < 2)
            return Enumerable.Empty<Responsavel>();
        var valorLower = valor.ToLower();
        using var db = await DbFactory.CreateDbContextAsync();
        return await db.Responsaveis
            .Where(r => r.Nome.ToLower().Contains(valorLower) || (r.CPF != null && r.CPF.Contains(valor)))
            .OrderBy(r => r.Nome)
            .Take(15)
            .ToListAsync(token);
    }

    private async Task<IEnumerable<Jazigo>> PesquisarJazigos(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor) || valor.Length < 2)
            return Enumerable.Empty<Jazigo>();
        var valorLower = valor.ToLower();
        using var db = await DbFactory.CreateDbContextAsync();
        return await db.Jazigos
            .Where(j => j.CodigoIdentificador.ToLower().Contains(valorLower))
            .OrderBy(j => j.CodigoIdentificador)
            .Take(15)
            .ToListAsync(token);
    }

    private static string? FormatarResponsavel(Responsavel? r)
        => r == null ? null : string.IsNullOrEmpty(r.CPF) ? r.Nome : $"{r.Nome} — {r.CPF}";

    private async Task Salvar()
    {
        await form.Validate();
        if (!form.IsValid) return;
        if (responsavel == null || !assuntoId.HasValue) return;
        salvando = true;
        try
        {
            var p = await ProtocoloService.AbrirAsync(
                responsavel.Id,
                assuntoId.Value,
                jazigo?.Id,
                observacao,
                dataAbertura.HasValue ? DateTime.SpecifyKind(dataAbertura.Value.Date, DateTimeKind.Utc) : null);
            Snackbar.Add($"Protocolo {p.Numero} aberto com sucesso.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(p.Id));
        }
        catch (DocumentoBloqueadoException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao abrir protocolo: {ex.Message}", Severity.Error);
        }
        finally
        {
            salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
