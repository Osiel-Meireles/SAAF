@page "/guia"
@attribute [Authorize]

<PageTitle>Guia do Usuário — Sakrus</PageTitle>

<style>
    .guia-fluxo { display: flex; flex-wrap: wrap; align-items: stretch; justify-content: center; gap: 8px; }
    .guia-etapa { flex: 1 1 150px; max-width: 190px; min-width: 150px; border-radius: 12px; padding: 12px 10px; text-align: center;
                  border: 2px solid var(--mud-palette-primary); background: var(--mud-palette-surface); position: relative; }
    .guia-etapa .num { width: 28px; height: 28px; line-height: 28px; border-radius: 50%; margin: 0 auto 6px; font-weight: 700;
                       background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .guia-etapa.opcional { border-style: dashed; border-color: var(--mud-palette-secondary); }
    .guia-etapa.opcional .num { background: var(--mud-palette-secondary); color: var(--mud-palette-secondary-text); }
    .guia-etapa.fim { border-color: var(--mud-palette-success); }
    .guia-etapa.fim .num { background: var(--mud-palette-success); color: var(--mud-palette-success-text); }
    .guia-seta { display: flex; align-items: center; font-size: 1.6rem; color: var(--mud-palette-text-secondary); }
    .guia-faixa { border-left: 6px solid var(--mud-palette-primary); border-radius: 8px; }
    .guia-passos { margin: 0; padding-left: 1.2rem; }
    .guia-passos li { margin-bottom: 6px; }
    @@media (max-width: 600px) { .guia-seta { transform: rotate(90deg); width: 100%; justify-content: center; } .guia-etapa { max-width: none; } }
</style>

<div class="mb-4">
    <MudText Typo="Typo.h4" Style="font-weight:700;">Guia do Usuário</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        Aprenda como o Sakrus organiza o trabalho da CAAFE e como executar cada processo, passo a passo.
    </MudText>
</div>

@* ── 1. Antes de começar ── *@
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    <b>Regra de ouro:</b> cadastre cada informação <b>uma única vez</b>. Os dados do responsável, do falecido, do jazigo e da
    funerária são reaproveitados automaticamente nos documentos. Por isso, o sistema <b>não pede para digitar de novo</b>
    o que já existe — basta selecionar. Os documentos <b>só são gerados quando você clica</b> em emitir e a numeração
    (protocolo, contrato, guia) <b>nunca muda</b> ao reimprimir.
</MudAlert>

@* ── 2. Diagrama geral ── *@
<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-1">Visão geral: do atendimento ao arquivo</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Siga as caixas da esquerda para a direita. Caixas com borda tracejada são etapas que só acontecem em alguns casos.
    </MudText>

    <div class="guia-fluxo">
        <div class="guia-etapa">
            <div class="num">1</div>
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Novo Atendimento</MudText>
            <MudText Typo="Typo.caption">Registra o responsável e o falecido</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa">
            <div class="num">2</div>
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Faturamento / OS</MudText>
            <MudText Typo="Typo.caption">Itens cobrados e número da guia</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa opcional">
            <div class="num">3</div>
            <MudIcon Icon="@Icons.Material.Filled.Church" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle2">Capela</MudText>
            <MudText Typo="Typo.caption">Velório, se houver (termo de uso ou dispensa)</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa">
            <div class="num">4</div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Sepultamento</MudText>
            <MudText Typo="Typo.caption">Escolhe a gaveta e registra data e hora</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa">
            <div class="num">5</div>
            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Documentos</MudText>
            <MudText Typo="Typo.caption">Termo e guia de sepultamento</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa opcional">
            <div class="num">6</div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle2">Exumação</MudText>
            <MudText Typo="Typo.caption">Possível 5 anos após o sepultamento</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa fim">
            <div class="num">7</div>
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Success" />
            <MudText Typo="Typo.subtitle2">Relatórios</MudText>
            <MudText Typo="Typo.caption">Acompanhamento e prestação de contas</MudText>
        </div>
    </div>

    <MudDivider Class="my-5" />

    <MudText Typo="Typo.h6" Class="mb-1">Fluxo do jazigo particular (concessão)</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Para famílias que possuem ou desejam um lote próprio, o caminho é este:
    </MudText>
    <div class="guia-fluxo">
        <div class="guia-etapa">
            <div class="num">A</div>
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Responsável</MudText>
            <MudText Typo="Typo.caption">Cadastre o concessionário</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa">
            <div class="num">B</div>
            <MudIcon Icon="@Icons.Material.Filled.FolderShared" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Protocolo</MudText>
            <MudText Typo="Typo.caption">Abra o processo (aquisição, regularização, construção)</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa">
            <div class="num">C</div>
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Vincular ao jazigo</MudText>
            <MudText Typo="Typo.caption">Titular do lote escolhido</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa">
            <div class="num">D</div>
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">Contrato e Termo</MudText>
            <MudText Typo="Typo.caption">Concessão do lote</MudText>
        </div>
        <div class="guia-seta">➜</div>
        <div class="guia-etapa fim">
            <div class="num">E</div>
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" />
            <MudText Typo="Typo.subtitle2">Folha Financeira</MudText>
            <MudText Typo="Typo.caption">Histórico de taxas e pagamentos</MudText>
        </div>
    </div>
</MudPaper>

@* ── 3. Passo a passo ── *@
<MudText Typo="Typo.h5" Class="mb-2">Como fazer cada processo</MudText>
<MudExpansionPanels MultiExpansion="true" Class="mb-6">
    @foreach (var p in _processos)
    {
        <MudExpansionPanel @key="p.Id">
            <TitleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@p.Icone" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@p.Titulo</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2" Class="mb-2"><b>Para que serve:</b> @p.Objetivo</MudText>
                <MudText Typo="Typo.body2" Class="mb-1"><b>Onde fica:</b> @p.Onde</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Passo a passo</MudText>
                <ol class="guia-passos">
                    @foreach (var passo in p.Passos)
                    {
                        <li><MudText Typo="Typo.body2" Inline="true">@((MarkupString)passo)</MudText></li>
                    }
                </ol>
                @if (p.Dicas.Length > 0)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="mt-3">
                        @foreach (var d in p.Dicas)
                        {
                            <div>💡 @((MarkupString)d)</div>
                        }
                    </MudAlert>
                }
                @if (!string.IsNullOrEmpty(p.Rota))
                {
                    <MudButton Href="@p.Rota" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-3"
                               EndIcon="@Icons.Material.Filled.OpenInNew">Ir para @p.Titulo</MudButton>
                }
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@* ── 4. Glossário e dúvidas ── *@
<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4 h-100">
            <MudText Typo="Typo.h6" Class="mb-2">Glossário</MudText>
            @foreach (var (termo, significado) in _glossario)
            {
                <MudText Typo="Typo.body2" Class="mb-2"><b>@termo:</b> @significado</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4 h-100">
            <MudText Typo="Typo.h6" Class="mb-2">Dúvidas frequentes</MudText>
            <MudExpansionPanels Elevation="0" Dense="true">
                @foreach (var (pergunta, resposta) in _faq)
                {
                    <MudExpansionPanel Text="@pergunta">
                        <MudText Typo="Typo.body2">@((MarkupString)resposta)</MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudPaper>
    </MudItem>
</MudGrid>

