@using Sakrus.Core.Entities
@using Sakrus.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@implements IDisposable
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (atendimento == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudForm @ref="form" @bind-IsValid="sucesso">
                <MudGrid>
                    @* --- DADOS DO RESPONSÁVEL --- *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Color="Color.Primary">Dados do Responsável</MudText>
                        <MudDivider Class="mb-3" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="atendimento.Responsavel.Nome" Label="Nome Completo" Required="true" RequiredError="O nome é obrigatório" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="atendimento.Responsavel.CPF" Label="CPF" Required="true" Mask="@(new PatternMask("000.000.000-00"))" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="atendimento.Responsavel.Telefone" Label="Telefone" Mask="@(new PatternMask("(00) 00000-0000"))" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="atendimento.Responsavel.Endereco" Label="Endereço Completo" />
                    </MudItem>

                    @* --- DADOS DO FALECIDO --- *@
                    <MudItem xs="12" Class="mt-4">
                        <div class="d-flex align-center justify-space-between">
                            <MudText Typo="Typo.h6" Color="Color.Primary">Dados do Falecido</MudText>
                            @if (!string.IsNullOrEmpty(atendimento.Falecido.CodigoIndigente))
                            {
                                <MudChip T="string" Color="@(atendimento.Falecido.EhIndigente ? Color.Warning : Color.Success)" Size="Size.Small" Icon="@(atendimento.Falecido.EhIndigente ? Icons.Material.Filled.PersonOff : Icons.Material.Filled.HowToReg)">
                                    @(atendimento.Falecido.EhIndigente ? "Indigente" : "Reconhecido") — @atendimento.Falecido.CodigoIndigente
                                </MudChip>
                            }
                        </div>
                        @if (atendimento.Falecido.EhIndigente)
                        {
                            <MudPaper Elevation="0" Class="pa-3 mt-2 mb-2" Style="border: 1px solid var(--mud-palette-warning); border-radius: 8px; background: rgba(var(--mud-palette-warning-rgb), 0.05);">
                                <div class="d-flex align-center justify-space-between gap-3">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Color="Color.Warning">Registro de Pessoa Indigente / Não Identificada</MudText>
                                            <MudText Typo="Typo.caption">Desmarque ao lado para concluir o reconhecimento civil e atualizar o status do registro.</MudText>
                                        </div>
                                    </div>
                                    <MudSwitch @bind-Value="atendimento.Falecido.EhIndigente" 
                                               Color="Color.Warning" 
                                               Label="@(atendimento.Falecido.EhIndigente ? "Status: Indigente" : "Reconhecido")" />
                                </div>
                            </MudPaper>
                        }
                        else if (!string.IsNullOrEmpty(atendimento.Falecido.CodigoIndigente))
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2 mb-2" Icon="@Icons.Material.Filled.HowToReg">
                                <div class="d-flex align-center justify-space-between">
                                    <span><strong>Reconhecimento Civil Realizado:</strong> Este registro iniciou como indigente (@atendimento.Falecido.CodigoIndigente), mas seu status civil foi formalmente atualizado.</span>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success" OnClick="@(() => atendimento.Falecido.EhIndigente = true)">Reverter para Indigente</MudButton>
                                </div>
                            </MudAlert>
                        }
                        <MudDivider Class="mb-3 mt-1" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="atendimento.Falecido.Nome"
                                      Label="Nome do Falecido"
                                      Required="@(!atendimento.Falecido.EhIndigente)"
                                      RequiredError="Nome é obrigatório"
                                      HelperText="@(atendimento.Falecido.EhIndigente ? "Opcional para indigentes" : null)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="atendimento.Falecido.Cpf"
                                      Label="CPF do Falecido"
                                      HelperText="@(atendimento.Falecido.EhIndigente ? "Opcional — preencha quando identificado" : "11 dígitos, sem pontuação")" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="CausaMorte" Label="Causa da Morte" @bind-Value="atendimento.Falecido.CausaMorte" Required="true">
                            @foreach (CausaMorte causa in Enum.GetValues(typeof(CausaMorte)))
                            {
                                <MudSelectItem Value="@causa">@causa.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="dataFalecimento" Label="Data do Falecimento" />
                    </MudItem>

                    @* --- INFORMAÇÕES DO ATENDIMENTO --- *@
                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.h6" Color="Color.Primary">Informações do Atendimento</MudText>
                        <MudDivider Class="mb-3" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="PerfilAtendimento" Label="Perfil" @bind-Value="atendimento.Perfil" Required="true">
                            @foreach (PerfilAtendimento perfil in Enum.GetValues(typeof(PerfilAtendimento)))
                            {
                                <MudSelectItem Value="@perfil">@perfil.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="OrigemAtendimento" Label="Origem" @bind-Value="atendimento.Origem" Required="true">
                            @foreach (OrigemAtendimento origem in Enum.GetValues(typeof(OrigemAtendimento)))
                            {
                                <MudSelectItem Value="@origem">@origem.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="TipoProcedimento" Label="Procedimento" @bind-Value="atendimento.Procedimento" Required="true">
                            @foreach (TipoProcedimento procedimento in Enum.GetValues(typeof(TipoProcedimento)))
                            {
                                <MudSelectItem Value="@procedimento">@procedimento.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="int?" Label="Funerária Credenciada" @bind-Value="atendimento.FunerariaId" Clearable="true">
                            <MudSelectItem T="int?" Value="null">Nenhuma / Próprio Município</MudSelectItem>
                            @foreach (var f in funerarias)
                            {
                                <MudSelectItem T="int?" Value="@((int?)f.Id)">@f.Nome</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="atendimento.NumeroDeclaracaoObito" Label="Nº Declaração de Óbito" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar" Disabled="@(!sucesso)">Salvar Alterações</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private ApplicationDbContext DbContext = default!;

    public void Dispose()
    {
        DbContext?.Dispose();
    }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int AtendimentoId { get; set; }

    private Atendimento? atendimento;
    private DateTime? dataFalecimento;
    private MudForm form = null!;
    private bool sucesso;
    private List<Funeraria> funerarias = new();

    protected override async Task OnInitializedAsync()
    {
        DbContext = DbFactory.CreateDbContext();
        funerarias = await DbContext.Funerarias.OrderBy(f => f.Nome).ToListAsync();
        await CarregarAtendimento();
    }

    private async Task CarregarAtendimento()
    {
        atendimento = await DbContext.Atendimentos
            .Include(a => a.Responsavel)
            .Include(a => a.Falecido)
            .FirstOrDefaultAsync(a => a.Id == AtendimentoId);

        if (atendimento?.Falecido != null)
        {
            dataFalecimento = atendimento.Falecido.DataFalecimento;
        }
    }

    private async Task Salvar()
    {
        await form.Validate();
        if (!form.IsValid || atendimento == null) return;

        if (!atendimento.Falecido.EhIndigente)
        {
            if (!string.IsNullOrWhiteSpace(atendimento.Responsavel.CPF) &&
                !Sakrus.Core.Helpers.DocumentValidator.IsCpfValido(atendimento.Responsavel.CPF))
            {
                Snackbar.Add("O CPF do Responsável é inválido.", Severity.Error);
                return;
            }
        }
        if (!string.IsNullOrWhiteSpace(atendimento.Falecido.Cpf) &&
            !Sakrus.Core.Helpers.DocumentValidator.IsCpfValido(atendimento.Falecido.Cpf))
        {
            Snackbar.Add("O CPF do Falecido é inválido.", Severity.Error);
            return;
        }

        if (!atendimento.Falecido.EhIndigente && 
            !string.IsNullOrEmpty(atendimento.Falecido.CodigoIndigente) && 
            atendimento.Falecido.Nome.StartsWith("INDIGENTE", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Por favor, atualize o nome do falecido com a identificação civil correta antes de desmarcar o modo indigente.", Severity.Warning);
            return;
        }

        try
        {
            if (!string.IsNullOrEmpty(atendimento.Responsavel?.CPF))
            {
                atendimento.Responsavel.CPF = new string(atendimento.Responsavel.CPF.Where(char.IsDigit).ToArray());
            }
            if (!string.IsNullOrEmpty(atendimento.Falecido?.Cpf))
            {
                atendimento.Falecido.Cpf = new string(atendimento.Falecido.Cpf.Where(char.IsDigit).ToArray());
            }

            if (dataFalecimento.HasValue)
            {
                atendimento.Falecido.DataFalecimento = dataFalecimento.Value;
            }

            DbContext.Atendimentos.Update(atendimento);
            await DbContext.SaveChangesAsync();

            Snackbar.Add("Atendimento atualizado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}

