@page "/responsaveis"
@attribute [Authorize]
@using Sakrus.Core.Entities
@using Sakrus.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IAuthService AuthService
@inject Sakrus.Services.FileStorageService FileStorage
@inject IJSRuntime JSRuntime
@inject ILogger<Responsaveis> Logger

<PageTitle>Responsáveis - Sakrus</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Cadastro de Responsáveis</MudText>

<MudTable Items="@responsaveis" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@isLoading"
          LoadingProgressColor="Color.Info" Dense="true" Elevation="2"
          Filter="new Func<ResponsavelVm, bool>(FilterFunc)">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Pessoas Cadastradas</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString" Placeholder="Buscar por nome ou CPF..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0 mr-4" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenAddForm">Novo Responsável</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>CPF</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh Style="text-align:center">Jazigos</MudTh>
        <MudTh Style="text-align:center">Atendimentos</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome">
            <div class="d-flex align-center gap-2">
                @if (context.EhProprietario)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Home" Color="Color.Primary" Size="Size.Small" Title="Proprietário de Jazigo" />
                }
                <MudText>@context.Nome</MudText>
            </div>
        </MudTd>
        <MudTd DataLabel="CPF">@FormatCpf(context.CPF)</MudTd>
        <MudTd DataLabel="Telefone">@context.Telefone</MudTd>
        <MudTd DataLabel="E-mail">@(context.Email ?? "—")</MudTd>
        <MudTd DataLabel="Jazigos" Style="text-align:center">
            @if (context.TotalJazigos > 0)
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@context.TotalJazigos</MudChip>
            }
            else
            {
                <MudText Color="Color.Secondary" Typo="Typo.caption">0</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Atendimentos" Style="text-align:center">
            <MudText Typo="Typo.body2">@context.TotalAtendimentos</MudText>
        </MudTd>
        <MudTd DataLabel="Ações">
            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Warning"
                           Size="Size.Small" Title="Ver Documentos"
                           OnClick="@(() => OpenDocumentos(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.HomeWork" Color="Color.Info"
                           Size="Size.Small" Title="Vincular a Jazigo"
                           OnClick="@(() => OpenVincularJazigo(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Secondary"
                           Size="Size.Small" Title="Gerenciar Falecidos Vinculados"
                           OnClick="@(() => OpenGerenciarFalecidos(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                           Size="Size.Small" OnClick="@(() => OpenEditForm(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                           Size="Size.Small" OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@if (showFalecidosPanel)
{
    <MudPaper Class="pa-4 mt-4" Elevation="3">
        <div class="d-flex align-center justify-space-between mb-3">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Class="mr-1" />
                Falecidos Vinculados — @responsavelFalecidosNome
            </MudText>
            <MudButton Variant="Variant.Text" OnClick="CloseFalecidosPanel">Fechar</MudButton>
        </div>

        @if (falecidosDoResponsavel.Any())
        {
            <MudTable Items="@falecidosDoResponsavel" Dense="true" Hover="true" Elevation="1" Class="mb-4">
                <HeaderContent>
                    <MudTh>Nome do Falecido</MudTh>
                    <MudTh>Data Falecimento</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Protocolo</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.NomeFalecido</MudTd>
                    <MudTd DataLabel="Data">@context.DataFalecimento.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        @switch (context.Status)
                        {
                            case StatusFalecido.NaoSepultado:
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Aguardando Sepultamento</MudChip>
                                break;
                            case StatusFalecido.Sepultado:
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Sepultado</MudChip>
                                break;
                            case StatusFalecido.Exumado:
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Exumado</MudChip>
                                break;
                        }
                    </MudTd>
                    <MudTd DataLabel="Protocolo">@(context.Protocolo ?? "—")</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">Nenhum falecido vinculado a este responsável.</MudAlert>
        }

        <MudDivider Class="mb-3" />
        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">Vincular Falecido Existente</MudText>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            Busque um falecido já cadastrado no sistema e vincule-o a este responsável criando um novo atendimento.
        </MudAlert>
        <MudGrid>
            <MudItem xs="12" sm="9">
                <MudAutocomplete T="FalecidoVinculoVm"
                                Label="Buscar Falecido (Nome ou CPF)"
                                @bind-Value="falecidoParaVincular"
                                SearchFunc="@PesquisarFalecidoParaVincular"
                                ToStringFunc="@(f => f == null ? null : $"{f.Nome} — {f.DataFalecimento.ToLocalTime():dd/MM/yyyy}")"
                                ResetValueOnEmptyText="true"
                                MinCharacters="2"
                                DebounceInterval="300"
                                Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-end pb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Link"
                           Disabled="@(falecidoParaVincular == null || isVinculandoFalecido)"
                           OnClick="VincularFalecidoAoResponsavel">
                    @if (isVinculandoFalecido)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Vincular
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (showForm)
{
    <MudPaper Class="pa-4 mt-4" Elevation="3">
        <MudText Typo="Typo.h6" Class="mb-3">@(isEditing ? "Editar Responsável" : "Novo Responsável")</MudText>
        <MudForm @ref="form" @bind-IsValid="sucesso">
            <MudGrid>
                @* Dados pessoais *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">Dados Pessoais</MudText>
                    <MudDivider Class="mb-2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="currentResp.Nome" Label="Nome Completo"
                                  Required="true" RequiredError="Nome é obrigatório" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="currentResp.CPF" Label="CPF (somente números)"
                                  Required="true" RequiredError="CPF é obrigatório"
                                  HelperText="11 dígitos, sem pontuação" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Data de Nascimento" @bind-Date="dataNascimentoForm" Editable="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="currentResp.RG" Label="RG" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="currentResp.OrgaoEmissor" Label="Órgão Emissor" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="currentResp.Profissao" Label="Profissão" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="currentResp.Telefone" Label="Telefone"
                                  Required="true" Placeholder="(00) 00000-0000" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="currentResp.Email" Label="E-mail" InputType="InputType.Email"
                                  HelperText="Futuramente usado para login GOV.br" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="currentResp.Endereco" Label="Endereço Completo"
                                  Required="true" />
                </MudItem>

                @* Upload de documentos — obrigatório apenas na criação *@
                @if (!isEditing)
                {
                    <MudItem xs="12" Class="mt-3">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">Documentos</MudText>
                        <MudDivider Class="mb-2" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Anexe ao menos <strong>1 documento</strong> em formato PDF (RG, CPF, comprovante de residência etc.). Máx. 10 MB por arquivo.
                        </MudAlert>
                        <InputFile id="fileInputResp" OnChange="OnFileSelected" multiple accept=".pdf" style="display:none" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AttachFile"
                                   OnClick="TriggerFileInput" Disabled="@isSaving">
                            Selecionar PDF(s)
                        </MudButton>
                        @if (arquivosParaAnexar.Any())
                        {
                            <MudList T="string" Dense="true" Class="mt-2">
                                @foreach (var arq in arquivosParaAnexar)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.PictureAsPdf" IconColor="Color.Error">
                                        <div class="d-flex align-center justify-space-between" style="width:100%">
                                            <MudText Typo="Typo.body2">
                                                @arq.Name
                                                <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(@FormatBytes(arq.Size))</MudText>
                                            </MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                           Color="Color.Error" OnClick="@(() => RemoverArquivo(arq))" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        @if (!string.IsNullOrEmpty(erroUpload))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@erroUpload</MudAlert>
                        }
                    </MudItem>
                }

                <MudItem xs="12" Class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Text" OnClick="CloseForm" Class="mr-2" Disabled="@isSaving">Cancelar</MudButton>
                    @if (isSaving)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            Salvando...
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(!sucesso)" OnClick="Save">Salvar</MudButton>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    private ApplicationDbContext DbContext = default!;
    public void Dispose() => DbContext?.Dispose();

    // ── ViewModel para a tabela (agrega contagens) ───────────────────────────
    private sealed record ResponsavelVm(
        int Id, string Nome, string? CPF, string? Email, string Telefone,
        bool EhProprietario, int TotalJazigos, int TotalAtendimentos);

    /// <summary>Projeção de falecido para o autocomplete de vínculo.</summary>
    private sealed record FalecidoVinculoVm(
        int Id, string Nome, DateTime DataFalecimento, StatusFalecido Status);

    private List<ResponsavelVm> responsaveis = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private bool sucesso;
    private bool isSaving;
    private string searchString = "";
    private MudForm form = null!;

    private Responsavel currentResp = new();
    private DateTime? dataNascimentoForm;

    // Upload
    private sealed record ArquivoBuffer(string Name, long Size, byte[] Bytes);
    private List<ArquivoBuffer> arquivosParaAnexar = new();
    private string erroUpload = "";
    private const long MaxFileSizeBytes = 10 * 1024 * 1024;

    // ── Painel de falecidos vinculados ──────────────────────────────────────────────────────
    private bool showFalecidosPanel = false;
    private int responsavelFalecidosId;
    private string responsavelFalecidosNome = "";
    private bool isVinculandoFalecido;
    private FalecidoVinculoVm? falecidoParaVincular;

    private sealed record FalecidoPainelVm(
        string NomeFalecido, DateTime DataFalecimento, StatusFalecido Status, string? Protocolo);
    private List<FalecidoPainelVm> falecidosDoResponsavel = new();

    private bool FilterFunc(ResponsavelVm r)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (r.Nome.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (r.CPF?.Contains(searchString) == true) return true;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        DbContext = DbFactory.CreateDbContext();
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        var lista = await DbContext.Responsaveis
            .Select(r => new
            {
                r.Id, r.Nome, r.CPF, r.Email, r.Telefone, r.EhProprietario,
                TotalJazigos = r.JazigoProprietarios.Count(jp => jp.Ativo),
                TotalAtendimentos = DbContext.Atendimentos.Count(a => a.ResponsavelId == r.Id)
            })
            .OrderBy(r => r.Nome)
            .ToListAsync();

        responsaveis = lista.Select(r => new ResponsavelVm(
            r.Id, r.Nome, r.CPF, r.Email, r.Telefone,
            r.EhProprietario, r.TotalJazigos, r.TotalAtendimentos
        )).ToList();
        isLoading = false;
    }

    private void OpenAddForm()
    {
        currentResp = new Responsavel();
        dataNascimentoForm = null;
        arquivosParaAnexar.Clear();
        erroUpload = "";
        isEditing = false;
        showForm = true;
    }

    private async Task OpenEditForm(ResponsavelVm vm)
    {
        var resp = await DbContext.Responsaveis.FindAsync(vm.Id);
        if (resp == null) return;
        currentResp = new Responsavel
        {
            Id = resp.Id, Nome = resp.Nome, CPF = resp.CPF, RG = resp.RG,
            OrgaoEmissor = resp.OrgaoEmissor, Profissao = resp.Profissao,
            Telefone = resp.Telefone, Endereco = resp.Endereco,
            Email = resp.Email, EhProprietario = resp.EhProprietario
        };
        dataNascimentoForm = resp.DataNascimento;
        isEditing = true;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        currentResp = new Responsavel();
        arquivosParaAnexar.Clear();
        erroUpload = "";
    }

    private async Task Save()
    {
        await form.Validate();
        if (!form.IsValid) return;

        // Validação: documento obrigatório apenas na criação
        if (!isEditing && !arquivosParaAnexar.Any())
        {
            Snackbar.Add("É obrigatório anexar ao menos um documento (RG, CPF etc.).", Severity.Error);
            return;
        }

        // Validação de CPF
        var cpfLimpo = new string((currentResp.CPF ?? "").Where(char.IsDigit).ToArray());
        if (!string.IsNullOrEmpty(cpfLimpo) && !Sakrus.Core.Helpers.DocumentValidator.IsCpfValido(cpfLimpo))
        {
            Snackbar.Add("O CPF informado é inválido.", Severity.Error);
            return;
        }

        // 2FA
        var param2FA = new DialogParameters
        {
            ["TituloOperacao"] = isEditing ? "Editar Responsável" : "Criar Responsável",
            ["MensagemConfirmacao"] = $"Você está prestes a {(isEditing ? "editar" : "criar")} o responsável '{currentResp.Nome}'. Confirme sua identidade."
        };
        var opt2FA = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dlg2FA = await DialogService.ShowAsync<ConfirmacaoSenhaDialog>("Confirmação de Segurança", param2FA, opt2FA);
        var res2FA = await dlg2FA.Result;
        if (res2FA == null || res2FA.Canceled) return;

        isSaving = true;
        StateHasChanged();

        await using var transaction = await DbContext.Database.BeginTransactionAsync();
        try
        {
            currentResp.CPF = string.IsNullOrEmpty(cpfLimpo) ? null : cpfLimpo;
            currentResp.DataNascimento = dataNascimentoForm.HasValue
                ? DateTime.SpecifyKind(dataNascimentoForm.Value, DateTimeKind.Utc)
                : null;

            if (isEditing)
            {
                var r = await DbContext.Responsaveis.FindAsync(currentResp.Id);
                if (r != null)
                {
                    r.Nome = currentResp.Nome; r.CPF = currentResp.CPF;
                    r.RG = currentResp.RG; r.OrgaoEmissor = currentResp.OrgaoEmissor;
                    r.Profissao = currentResp.Profissao; r.Telefone = currentResp.Telefone;
                    r.Endereco = currentResp.Endereco; r.Email = currentResp.Email;
                    r.DataNascimento = currentResp.DataNascimento;
                    DbContext.Responsaveis.Update(r);
                }
            }
            else
            {
                DbContext.Responsaveis.Add(currentResp);
                await DbContext.SaveChangesAsync();

                // Salvar documentos
                if (arquivosParaAnexar.Any())
                {
                    foreach (var arquivo in arquivosParaAnexar)
                    {
                        // CRIT-01/02/03: FileStorageService — magic bytes, seguro, UUID no disco
                        var caminhoRelativo = await FileStorage.SalvarArquivoAsync(
                            "responsaveis", currentResp.Id, arquivo.Name, arquivo.Bytes);

                        DbContext.DocumentosAnexos.Add(new DocumentoAnexo
                        {
                            ResponsavelId = currentResp.Id,
                            Tipo = TipoDocumentoAnexo.Outro,
                            NomeArquivo = arquivo.Name,
                            CaminhoArquivo = caminhoRelativo,
                            TamanhoBytes = arquivo.Bytes.LongLength,
                            DataAnexo = DateTime.UtcNow
                        });
                    }
                }
            }

            await DbContext.SaveChangesAsync();
            await transaction.CommitAsync();

            Snackbar.Add($"Responsável {(isEditing ? "atualizado" : "cadastrado")} com sucesso!", Severity.Success);
            CloseForm();
            DbContext.ChangeTracker.Clear();
            await LoadData();
        }
        catch (InvalidOperationException ex)
        {
            await transaction.RollbackAsync();
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Logger.LogError(ex, "Erro ao salvar responsável");
            Snackbar.Add("Ocorreu um erro ao salvar o responsável. Tente novamente.", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task Delete(ResponsavelVm vm)
    {
        if (vm.TotalAtendimentos > 0 || vm.TotalJazigos > 0)
        {
            Snackbar.Add("Não é possível excluir: este responsável possui atendimentos ou jazigos vinculados.", Severity.Warning);
            return;
        }

        var param2FA = new DialogParameters
        {
            ["TituloOperacao"] = "Excluir Responsável",
            ["MensagemConfirmacao"] = $"Você está prestes a excluir o responsável '{vm.Nome}'. Esta ação é irreversível."
        };
        var opt2FA = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dlg2FA = await DialogService.ShowAsync<ConfirmacaoSenhaDialog>("Confirmação de Segurança", param2FA, opt2FA);
        var res2FA = await dlg2FA.Result;
        if (res2FA == null || res2FA.Canceled) return;

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir Responsável",
            $"Tem certeza que deseja excluir '{vm.Nome}'? Esta ação é irreversível.",
            yesText: "Excluir", cancelText: "Cancelar");
        if (confirm != true) return;

        try
        {
            var r = await DbContext.Responsaveis.FindAsync(vm.Id);
            if (r != null)
            {
                DbContext.Responsaveis.Remove(r);
                await DbContext.SaveChangesAsync();
                Snackbar.Add("Responsável removido.", Severity.Success);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao excluir: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenDocumentos(ResponsavelVm vm)
    {
        var param = new DialogParameters
        {
            ["ResponsavelId"] = vm.Id,
            ["ResponsavelNome"] = vm.Nome
        };
        var opt = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<DocumentosResponsavelDialog>("Documentos do Responsável", param, opt);
    }

    private async Task OpenVincularJazigo(ResponsavelVm vm)
    {
        var param = new DialogParameters
        {
            ["ResponsavelId"] = vm.Id,
            ["ResponsavelNome"] = vm.Nome
        };
        var opt = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dlg = await DialogService.ShowAsync<VincularProprietarioDialog>("Vincular Responsável a Jazigo", param, opt);
        var result = await dlg.Result;
        if (result is { Canceled: false })
        {
            DbContext.ChangeTracker.Clear();
            await LoadData();
        }
    }

    // ── Upload ───────────────────────────────────────────────────────────────

    private async Task TriggerFileInput()
        => await JSRuntime.InvokeVoidAsync("triggerFileInput", "fileInputResp"); // HIGH-04

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        erroUpload = "";
        var rejeitados = new List<string>();
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)
                && !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                rejeitados.Add($"{file.Name} (apenas PDF)"); continue;
            }
            if (file.Size > MaxFileSizeBytes) { rejeitados.Add($"{file.Name} (excede 10 MB)"); continue; }
            if (arquivosParaAnexar.Any(a => a.Name == file.Name)) continue;
            try
            {
                using var ms = new MemoryStream();
                await using var stream = file.OpenReadStream(MaxFileSizeBytes);
                await stream.CopyToAsync(ms);
                arquivosParaAnexar.Add(new ArquivoBuffer(file.Name, file.Size, ms.ToArray()));
            }
            catch (Exception ex) { rejeitados.Add($"{file.Name} (erro: {ex.Message})"); }
        }
        if (rejeitados.Any()) erroUpload = $"Rejeitado(s): {string.Join("; ", rejeitados)}";
    }

    private void RemoverArquivo(ArquivoBuffer arq)
    {
        arquivosParaAnexar.Remove(arq);
        erroUpload = "";
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static string FormatCpf(string? cpf)
    {
        if (string.IsNullOrEmpty(cpf) || cpf.Length != 11) return cpf ?? "—";
        return $"{cpf[..3]}.{cpf[3..6]}.{cpf[6..9]}-{cpf[9..]}";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    // ── Gerenciar Falecidos Vinculados ────────────────────────────────────────

    private async Task OpenGerenciarFalecidos(ResponsavelVm vm)
    {
        responsavelFalecidosId   = vm.Id;
        responsavelFalecidosNome = vm.Nome;
        falecidoParaVincular     = null;

        // Carregar falecidos já vinculados via atendimentos
        var atendimentos = await DbContext.Atendimentos
            .Include(a => a.Falecido)
            .Where(a => a.ResponsavelId == vm.Id)
            .ToListAsync();

        falecidosDoResponsavel = atendimentos
            .Select(a => new FalecidoPainelVm(
                a.Falecido.Nome,
                a.Falecido.DataFalecimento,
                a.Falecido.Status,
                a.NumeroOsAuxilio))
            .ToList();

        showFalecidosPanel = true;
        showForm = false;
        StateHasChanged();
    }

    private void CloseFalecidosPanel()
    {
        showFalecidosPanel     = false;
        falecidoParaVincular   = null;
        falecidosDoResponsavel = new();
    }

    private async Task<IEnumerable<FalecidoVinculoVm>> PesquisarFalecidoParaVincular(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor) || valor.Length < 2)
            return Enumerable.Empty<FalecidoVinculoVm>();

        var valorLower = valor.ToLower();
        var lista = await DbContext.Falecidos
            .Where(f => f.Nome.ToLower().Contains(valorLower) ||
                        (f.Cpf != null && f.Cpf.Contains(valor)))
            .Take(15)
            .ToListAsync(token);

        return lista.Select(f => new FalecidoVinculoVm(f.Id, f.Nome, f.DataFalecimento, f.Status));
    }

    private async Task VincularFalecidoAoResponsavel()
    {
        if (falecidoParaVincular == null) return;

        // Verificar se já existe atendimento para esse falecido com esse responsável
        var jaExiste = await DbContext.Atendimentos
            .AnyAsync(a => a.FalecidoId == falecidoParaVincular.Id && a.ResponsavelId == responsavelFalecidosId);
        if (jaExiste)
        {
            Snackbar.Add("Este falecido já está vinculado a este responsável.", Severity.Warning);
            return;
        }

        isVinculandoFalecido = true;
        StateHasChanged();

        try
        {
            // Buscar atendimento existente do falecido para atualizar o responsável
            var atendimentoExistente = await DbContext.Atendimentos
                .FirstOrDefaultAsync(a => a.FalecidoId == falecidoParaVincular.Id);

            if (atendimentoExistente != null)
            {
                atendimentoExistente.ResponsavelId = responsavelFalecidosId;
                DbContext.Atendimentos.Update(atendimentoExistente);
                await DbContext.SaveChangesAsync();
                Snackbar.Add($"Falecido '{falecidoParaVincular.Nome}' vinculado com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Falecido sem atendimento registrado. Crie um atendimento para ele em 'Novo Registro'.", Severity.Warning);
            }

            falecidoParaVincular = null;
            DbContext.ChangeTracker.Clear();
            await OpenGerenciarFalecidos(new ResponsavelVm(
                responsavelFalecidosId, responsavelFalecidosNome, null, null, "", false, 0, 0));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao vincular falecido ao responsável");
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isVinculandoFalecido = false;
            StateHasChanged();
        }
    }
}
