@page "/novo-atendimento"
@attribute [Authorize]
@using Sakrus.Core.Entities
@using Sakrus.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@implements IDisposable
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject Sakrus.Services.IAuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@inject Sakrus.Services.FileStorageService FileStorage
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ILogger<NovoAtendimento> Logger

<PageTitle>Novo Atendimento - Sakrus</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Registro de Novo Atendimento</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudForm @ref="form" @bind-IsValid="@sucesso">
        <MudGrid>
            @* ── MODO INDIGENTE ─────────────────────────────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-3 mb-1" Style="@(EhIndigente ? "border: 2px solid var(--mud-palette-warning); border-radius: 8px; background: rgba(var(--mud-palette-warning-rgb), 0.05);" : "border: 1px dashed var(--mud-palette-lines-default); border-radius: 8px;")">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Color="@(EhIndigente ? Color.Warning : Color.Default)" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.subtitle2">Atendimento de Pessoa Indigente</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Marque quando o falecido não possui documentos de identificação. Os dados pessoais serão ocultados e um código único será gerado.</MudText>
                        </div>
                        <MudSwitch @bind-Value="EhIndigente" Color="Color.Warning" Label="@(EhIndigente ? "Modo Indigente ATIVO" : "Modo Indigente")" />
                    </div>
                </MudPaper>
            </MudItem>

            @* --- 1. DADOS DO RESPONSÁVEL — oculto para indigentes --- *@
            @if (!EhIndigente)
            {
                <MudItem xs="12" Class="mt-3">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Dados do Responsável</MudText>
                    <MudDivider Class="mb-3" />
                </MudItem>

                <MudItem xs="12" sm="9">
                    <MudAutocomplete T="Responsavel" Label="Pesquisar Responsável (Nome ou CPF)"
                                     @bind-Value="responsavelSelecionado"
                                     SearchFunc="@PesquisarResponsavel"
                                     ToStringFunc="@(r => r == null ? null : $"{r.Nome} (CPF: {r.CPF})")"
                                     Required="true" RequiredError="Selecione ou cadastre um responsável"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false" CoerceValue="false" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-end pb-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirNovoResponsavelDialog">
                        Novo Responsável
                    </MudButton>
                </MudItem>
            }

            @* --- 2. DADOS DO FALECIDO --- *@
            <MudItem xs="12" Class="mt-4">
                <MudText Typo="Typo.h6" Color="Color.Primary">Dados do Falecido</MudText>
                <MudDivider Class="mb-3" />
            </MudItem>

            @* Identificação — oculta para indigentes *@
            @if (!EhIndigente)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="novoAtendimento.Falecido.Nome" Label="Nome Completo do Falecido" Required="true" RequiredError="Nome é obrigatório" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="novoAtendimento.Falecido.Cpf" Label="CPF do Falecido (somente números)" Required="true" RequiredError="CPF é obrigatório" HelperText="11 dígitos, sem pontuação" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Data de Nascimento" @bind-Date="dataNascimento" Editable="true" HelperText="Opcional — usado para regra de jazigo infantil" />
                </MudItem>
            }

            @* Data e Local do Falecimento — sempre visíveis *@
            <MudItem xs="12" sm="@(EhIndigente ? 6 : 3)">
                <MudDatePicker Label="Data de Falecimento" @bind-Date="dataFalecimento" Required="true" RequiredError="Data obrigatória" />
            </MudItem>
            
            @if (!EhIndigente)
            {
                @if (novoAtendimento.Falecido.TipoRestosMortais != TipoRestosMortais.PecaAnatomica)
                {
                    <MudItem xs="12" sm="3">
                        <MudSelect T="CausaMorte" Label="Causa da Morte" @bind-Value="novoAtendimento.Falecido.CausaMorte" Required="true">
                            @foreach (CausaMorte causa in Enum.GetValues(typeof(CausaMorte)))
                            {
                                <MudSelectItem Value="@causa">@causa.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="novoAtendimento.PecaAnatomicaHospital" Label="Hospital de Origem / CRM Médico" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="novoAtendimento.PecaAnatomicaIdentificacao" Label="Identificação da Peça" Required="true" />
                    </MudItem>
                }

                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudSelect T="TipoRestosMortais" Label="Tipo Restos Mortais" @bind-Value="novoAtendimento.Falecido.TipoRestosMortais" Required="true">
                        @foreach (TipoRestosMortais tipo in Enum.GetValues(typeof(TipoRestosMortais)))
                        {
                            <MudSelectItem Value="@tipo">@tipo.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="novoAtendimento.NumeroDeclaracaoObito" Label="Nº Declaração de Óbito" Required="true" />
                </MudItem>
            }

            <MudItem xs="12" sm="@(EhIndigente ? 6 : 4)">
                <MudTextField @bind-Value="novoAtendimento.LocalFalecimento" Label="Local do Falecimento" Required="true" />
            </MudItem>

            @* --- 3. INFORMAÇÕES DO ATENDIMENTO --- *@
            <MudItem xs="12" Class="mt-4">
                <MudText Typo="Typo.h6" Color="Color.Primary">Classificação do Atendimento</MudText>
                <MudDivider Class="mb-3" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="PerfilAtendimento" Label="Perfil" @bind-Value="novoAtendimento.Perfil" Required="true"
                           HelperText="@(EhIndigente ? "Selecione a classificação do atendimento" : null)">
                    @foreach (PerfilAtendimento perfil in Enum.GetValues(typeof(PerfilAtendimento)))
                    {
                        <MudSelectItem Value="@perfil">@perfil.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="OrigemAtendimento" Label="Origem / Convênio" @bind-Value="novoAtendimento.Origem" Required="true"
                           HelperText="@(EhIndigente ? "Selecione a origem/convênio" : null)">
                    @foreach (OrigemAtendimento origem in Enum.GetValues(typeof(OrigemAtendimento)))
                    {
                        <MudSelectItem Value="@origem">@origem.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="TipoProcedimento" Label="Procedimento" @bind-Value="novoAtendimento.Procedimento" Required="true">
                    @foreach (TipoProcedimento procedimento in Enum.GetValues(typeof(TipoProcedimento)))
                    {
                        <MudSelectItem Value="@procedimento">@procedimento.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="int?" Label="Funerária Credenciada (Opcional)" @bind-Value="novoAtendimento.FunerariaId">
                    <MudSelectItem T="int?" Value="null">Nenhuma / Próprio Município</MudSelectItem>
                    @foreach (var f in funerarias)
                    {
                        <MudSelectItem T="int?" Value="@f.Id">@f.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* --- 4. DOCUMENTOS ANEXADOS --- *@
            @if (!EhIndigente)
            {
                <MudItem xs="12" Class="mt-4">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Documentos Anexados (PDF)</MudText>
                    <MudDivider Class="mb-3" />
                </MudItem>

                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        Anexe ao menos <strong>1 documento</strong> em formato <strong>PDF</strong> (ex: Declaração de Óbito — máx. 10 MB por arquivo).
                        Os documentos ficarão vinculados exclusivamente ao falecido deste atendimento.
                    </MudAlert>

                    <InputFile id="fileInput" OnChange="OnFileSelected" multiple accept=".pdf" style="display:none" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               OnClick="@TriggerFileInput"
                               Disabled="@isSaving">
                        Selecionar PDF(s)
                    </MudButton>

                    @if (arquivosParaAnexar.Any())
                    {
                        <MudList T="string" Dense="true" Class="mt-2">
                            @foreach (var arq in arquivosParaAnexar)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.PictureAsPdf" IconColor="Color.Error">
                                    <div class="d-flex align-center justify-space-between" style="width:100%">
                                        <MudText Typo="Typo.body2">@arq.Name <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(@FormatBytes(arq.Size))</MudText></MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoverArquivo(arq))" />
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    @if (!string.IsNullOrEmpty(erroUpload))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@erroUpload</MudAlert>
                    }
                </MudItem>
            }

            @* --- BOTÃO DE AÇÃO --- *@
            <MudItem xs="12" Class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Text" Color="Color.Default" Class="mr-2" OnClick="@Cancelar" Disabled="@isSaving">Cancelar</MudButton>
                @if (isSaving)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        Salvando...
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!sucesso)" OnClick="@SalvarAtendimento">Salvar Atendimento</MudButton>
                }
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    private ApplicationDbContext DbContext = default!;

    public void Dispose()
    {
        DbContext?.Dispose();
    }

    private MudForm form = null!;
    private bool sucesso;
    private bool isSaving;
    private bool ehIndigente = false;
    private bool EhIndigente
    {
        get => ehIndigente;
        set
        {
            if (ehIndigente != value)
            {
                ehIndigente = value;
                if (ehIndigente)
                {
                    novoAtendimento.Perfil = PerfilAtendimento.Indigente;
                    novoAtendimento.Origem = OrigemAtendimento.AssistenciaMunicipal;
                }
            }
        }
    }
    
    // Instancia o objeto já com as entidades filhas para evitar NullReferenceException no Bind do form
    private Atendimento novoAtendimento = new Atendimento
    {
        Falecido = new Falecido()
    };
    
    private Responsavel? responsavelSelecionado;
    
    private DateTime? dataFalecimento = DateTime.Today;
    private DateTime? dataNascimento;
    private List<Funeraria> funerarias = new();

    private async Task<IEnumerable<Responsavel>> PesquisarResponsavel(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return await DbContext.Responsaveis.Take(20).ToListAsync(token);
        
        return await DbContext.Responsaveis
            .Where(r => r.Nome.Contains(valor, StringComparison.OrdinalIgnoreCase) || 
                        (r.CPF != null && r.CPF.Contains(valor)))
            .Take(20)
            .ToListAsync(token);
    }

    private async Task AbrirNovoResponsavelDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NovoResponsavelDialog>("Novo Responsável", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is Responsavel novoResp)
        {
            responsavelSelecionado = novoResp;
        }
    }

    // Upload de documentos
    // FIX: IBrowserFile torna-se inválido após re-render do componente.
    // Os bytes são lidos de forma eagerly no OnFileSelected e armazenados em ArquivoBuffer.
    private sealed record ArquivoBuffer(string Name, long Size, byte[] Bytes);
    private List<ArquivoBuffer> arquivosParaAnexar = new();
    private string erroUpload = "";
    private const long MaxFileSizeBytes = 10 * 1024 * 1024; // 10 MB

    protected override async Task OnInitializedAsync()
    {
        DbContext = DbFactory.CreateDbContext();
        funerarias = await DbContext.Funerarias.ToListAsync();
    }

    private async Task TriggerFileInput()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('fileInput').click()");
    }

    // FIX: Tornado async para ler os bytes imediatamente, antes que o IBrowserFile expire.
    // Referência: https://aka.ms/aspnet/blazor-input-file-multiple-selections
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        erroUpload = "";
        var arquivosInvalidos = new List<string>();

        foreach (var file in e.GetMultipleFiles(20))
        {
            // Validação de tipo
            if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)
                && !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                arquivosInvalidos.Add($"{file.Name} (tipo inválido — apenas PDF)");
                continue;
            }

            // Validação de tamanho
            if (file.Size > MaxFileSizeBytes)
            {
                arquivosInvalidos.Add($"{file.Name} (excede 10 MB)");
                continue;
            }

            // Evitar duplicatas pelo nome
            if (arquivosParaAnexar.Any(a => a.Name == file.Name))
                continue;

            // Ler os bytes agora enquanto o IBrowserFile ainda é válido
            try
            {
                using var ms = new MemoryStream();
                await using var readStream = file.OpenReadStream(MaxFileSizeBytes);
                await readStream.CopyToAsync(ms);
                arquivosParaAnexar.Add(new ArquivoBuffer(file.Name, file.Size, ms.ToArray()));
            }
            catch (Exception ex)
            {
                arquivosInvalidos.Add($"{file.Name} (erro ao ler: {ex.Message})");
            }
        }

        if (arquivosInvalidos.Any())
        {
            erroUpload = $"Arquivo(s) rejeitado(s): {string.Join("; ", arquivosInvalidos)}";
        }
    }

    private void RemoverArquivo(ArquivoBuffer arquivo)
    {
        arquivosParaAnexar.Remove(arquivo);
        erroUpload = "";
    }

    private string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private async Task SalvarAtendimento()
    {
        await form.Validate();
        if (!form.IsValid) return;
        if (!string.IsNullOrWhiteSpace(novoAtendimento.Falecido.Cpf) && !Sakrus.Core.Helpers.DocumentValidator.IsCpfValido(novoAtendimento.Falecido.Cpf))
        {
            Snackbar.Add("O CPF do Falecido é inválido.", Severity.Error);
            return;
        }

        if (!EhIndigente && !arquivosParaAnexar.Any())
        {
            Snackbar.Add("É obrigatório anexar ao menos um documento do falecido (ex: Declaração de Óbito).", Severity.Error);
            return;
        }

        isSaving = true;
        StateHasChanged();

        await using var transaction = await DbContext.Database.BeginTransactionAsync();
        try
        {
            if (dataFalecimento.HasValue)
                novoAtendimento.Falecido.DataFalecimento = DateTime.SpecifyKind(dataFalecimento.Value, DateTimeKind.Utc);
            else
                novoAtendimento.Falecido.DataFalecimento = DateTime.UtcNow;

            if (dataNascimento.HasValue)
                novoAtendimento.Falecido.DataNascimento = DateTime.SpecifyKind(dataNascimento.Value, DateTimeKind.Utc);

            // ROB-04: Lógica de vinculação do Responsável
            if (EhIndigente)
            {
                // Indigente: responsável genérico
                novoAtendimento.Falecido.EhIndigente = true;
                
                // Procurar responsável "Não Identificado" ou criar
                var respIndigente = await DbContext.Responsaveis.FirstOrDefaultAsync(r => r.Nome == "Não Identificado" && r.CPF == "00000000000");
                if (respIndigente == null)
                {
                    respIndigente = new Responsavel { Nome = "Não Identificado", CPF = "00000000000", Endereco = "NI", RG = "NI", OrgaoEmissor = "NI", Telefone = "NI" };
                    DbContext.Responsaveis.Add(respIndigente);
                    await DbContext.SaveChangesAsync();
                }
                
                novoAtendimento.Responsavel = respIndigente;
                novoAtendimento.ResponsavelId = respIndigente.Id;
            }
            else
            {
                // Não-indigente: usar o responsável selecionado no Autocomplete
                if (responsavelSelecionado == null)
                {
                    Snackbar.Add("Selecione ou cadastre um responsável.", Severity.Error);
                    await transaction.RollbackAsync();
                    isSaving = false;
                    StateHasChanged();
                    return;
                }
                
                // Como ele pode ter sido criado em outra instância de DbContext (no Dialog),
                // precisamos anexá-lo ou buscar do banco local para evitar erro de tracking
                var respAnexado = await DbContext.Responsaveis.FindAsync(responsavelSelecionado.Id);
                if (respAnexado != null)
                {
                    novoAtendimento.ResponsavelId = respAnexado.Id;
                    novoAtendimento.Responsavel = respAnexado;
                }
                else
                {
                    // Caso excepcional onde ele não tá no banco ainda? Não deve acontecer pq o Dialog já salvou.
                    novoAtendimento.ResponsavelId = responsavelSelecionado.Id;
                    DbContext.Responsaveis.Attach(responsavelSelecionado);
                    novoAtendimento.Responsavel = responsavelSelecionado;
                }
            }

            // Salvar Falecido primeiro se for novo
            if (novoAtendimento.FalecidoId == 0 || novoAtendimento.Falecido.Id == 0)
            {
                // Limpar CPF do falecido também
                if (!string.IsNullOrEmpty(novoAtendimento.Falecido.Cpf))
                {
                    novoAtendimento.Falecido.Cpf = new string(novoAtendimento.Falecido.Cpf.Where(char.IsDigit).ToArray());
                }
                // Se indigente e sem nome, usar placeholder temporário
                if (EhIndigente && string.IsNullOrWhiteSpace(novoAtendimento.Falecido.Nome))
                    novoAtendimento.Falecido.Nome = "INDIGENTE (a identificar)";

                DbContext.Falecidos.Add(novoAtendimento.Falecido);
                await DbContext.SaveChangesAsync();
                novoAtendimento.FalecidoId = novoAtendimento.Falecido.Id;

                // Gerar código de indigente após obter o ID
                if (EhIndigente)
                {
                    novoAtendimento.Falecido.CodigoIndigente = $"IND-{DateTime.UtcNow.Year}-{novoAtendimento.Falecido.Id:D6}";
                    // Se o nome ainda era placeholder, atualizar com código
                    if (novoAtendimento.Falecido.Nome == "INDIGENTE (a identificar)")
                        novoAtendimento.Falecido.Nome = $"INDIGENTE - {novoAtendimento.Falecido.CodigoIndigente}";
                    DbContext.Falecidos.Update(novoAtendimento.Falecido);
                    await DbContext.SaveChangesAsync();
                }
            }

            // Agora salvar o Atendimento com as FK corrigidas
            DbContext.Atendimentos.Add(novoAtendimento);
            await DbContext.SaveChangesAsync();

            // Gerar número de protocolo automaticamente com base no ID gerado pelo banco
            // Formato: PROT-{ANO}-{ID com 6 dígitos} — garante unicidade e rastreabilidade
            novoAtendimento.NumeroOsAuxilio = $"PROT-{DateTime.UtcNow.Year}-{novoAtendimento.Id:D6}";
            await DbContext.SaveChangesAsync();

            // --- Salvar arquivos PDF em disco e criar registros no banco ---
            if (arquivosParaAnexar.Any())
            {
                foreach (var arquivo in arquivosParaAnexar)
                {
                    // CRIT-01/02/03: FileStorageService — magic bytes, seguro, UUID no disco
                    var caminhoRelativo = await FileStorage.SalvarArquivoAsync(
                        "atendimentos", novoAtendimento.FalecidoId, arquivo.Name, arquivo.Bytes);

                    var doc = new DocumentoAnexo
                    {
                        AtendimentoId = novoAtendimento.Id,
                        FalecidoId = novoAtendimento.FalecidoId,
                        NomeArquivo = arquivo.Name,
                        CaminhoArquivo = caminhoRelativo,
                        TamanhoBytes = arquivo.Bytes.LongLength,
                        DataAnexo = DateTime.UtcNow
                    };
                    DbContext.DocumentosAnexos.Add(doc);
                }

                await DbContext.SaveChangesAsync();
            }

            await transaction.CommitAsync();
            
            // FEAT-01: Auditoria
            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                if (user.Identity?.IsAuthenticated == true)
                {
                    int userId = int.Parse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
                    string userName = user.Identity.Name ?? "Desconhecido";
                    
                    await AuditService.LogAcaoAsync(
                        userId, userName, "CREATE", "Atendimento", novoAtendimento.Id.ToString(), null, 
                        new { novoAtendimento.NumeroOsAuxilio, FalecidoId = novoAtendimento.FalecidoId, ResponsavelId = novoAtendimento.ResponsavelId, DocumentosAnexados = arquivosParaAnexar.Count }
                    );
                }
            }
            catch (Exception ex)
            {
                // ROB-02: Silenciar e registrar erro de auditoria para não quebrar o fluxo do operador
                Console.WriteLine($"Erro ao registrar auditoria: {ex.Message}");
            }
            
            var numeroProtocolo = novoAtendimento.NumeroOsAuxilio;
            Snackbar.Add(
                $"✅ Atendimento registrado com sucesso! Protocolo gerado: {numeroProtocolo}",
                Severity.Success,
                config =>
                {
                    config.VisibleStateDuration = 8000;
                    config.ShowCloseIcon = true;
                }
            );
            Navigation.NavigateTo("/obitos");
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Snackbar.Add($"Erro ao salvar: {ex.Message}", Severity.Error);
            isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/obitos");
    }
}
