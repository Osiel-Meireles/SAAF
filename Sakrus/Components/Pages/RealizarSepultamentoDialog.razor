@using MudBlazor
@using Sakrus.Core.Entities
@using Sakrus.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" />
            <MudText Typo="Typo.h6">Realizar Sepultamento - @FalecidoNome</MudText>
            @if (falecidoIsInfantil)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.ChildCare">Infantil (≤ 12 anos)</MudChip>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-4" />
        }
        else
        {
            <MudForm @ref="form" @bind-IsValid="sucesso">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Data do Sepultamento" @bind-Date="dataSepultamento" Required="true" RequiredError="Data é obrigatória" Editable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTimePicker Label="Horário do Sepultamento" @bind-Time="horarioSepultamento" Editable="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudRadioGroup @bind-Value="tipoLocal" T="string" Required="true">
                            <MudRadio Value="@("Jazigo")" Color="Color.Primary">Jazigo</MudRadio>
                            <MudRadio Value="@("Gaveta")" Color="Color.Secondary">Gaveta Pública</MudRadio>
                        </MudRadioGroup>
                    </MudItem>

                    @* ── Seleção pelo Mapa ─────────────────────────────────────────── *@
                    @if (tipoLocal == "Jazigo" || tipoLocal == "Gaveta")
                    {
                        <MudItem xs="12">
                            @if (localSelecionado == null)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Map"
                                           FullWidth="true"
                                           OnClick="AbrirMapaSelecao">
                                    Selecionar @(tipoLocal == "Jazigo" ? "Jazigo" : "Gaveta") no Mapa
                                </MudButton>
                                @if (tipoLocalAlterado)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                                        Tipo alterado — selecione novamente no mapa.
                                    </MudText>
                                }
                            }
                            else
                            {
                                @* Card com o local selecionado *@
                                <MudPaper Class="pa-3 d-flex align-center gap-3"
                                          Style="border:2px solid #4caf50; border-radius:8px; background:rgba(76,175,80,0.07);">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Local selecionado:</MudText>
                                        <MudText Typo="Typo.body1" Style="font-weight:600;">@localSelecionado.Descricao</MudText>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="AbrirMapaSelecao"
                                                   Title="Alterar seleção" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="LimparLocal"
                                                   Title="Remover seleção" />
                                </MudPaper>
                            }
                        </MudItem>

                        @* Anos de permanência — apenas para Gaveta Pública *@
                        @if (tipoLocal == "Gaveta")
                        {
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="int" Label="Anos Permanência" @bind-Value="anosPermanencia" Min="1" Max="10" Required="true" />
                            </MudItem>
                        }
                    }
                </MudGrid>
            </MudForm>

            <AgendaDoDia DataSelecionada="@dataSepultamento" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="Confirmar"
                   Disabled="@(!sucesso || isLoading || localSelecionado == null)">
            Confirmar Sepultamento
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private ApplicationDbContext DbContext = default!;

    public void Dispose()
    {
        DbContext?.Dispose();
    }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int AtendimentoId { get; set; }
    [Parameter] public int FalecidoId { get; set; }
    [Parameter] public string FalecidoNome { get; set; } = "";

    /// <summary>Data de nascimento do falecido — usada para determinar se é infantil (≤ 12 anos).</summary>
    [Parameter] public DateTime? FalecidoDataNascimento { get; set; }

    /// <summary>Data de falecimento do falecido — referência para calcular a idade.</summary>
    [Parameter] public DateTime FalecidoDataFalecimento { get; set; }

    private MudForm form = null!;
    private bool sucesso;
    private bool isLoading = false;

    private DateTime? dataSepultamento = DateTime.Today;
    private TimeSpan? horarioSepultamento = DateTime.Now.TimeOfDay;
    private string tipoLocal = "Jazigo";
    private int anosPermanencia = 3;
    private bool tipoLocalAlterado = false;

    /// <summary>Resultado retornado pelo dialog do mapa.</summary>
    private SelecionarLocalSepultamentoDialog.ResultadoSelecaoLocal? localSelecionado;

    /// <summary>True se o falecido tinha 12 anos ou menos ao falecer.</summary>
    private bool falecidoIsInfantil;

    private string _ultimoTipoLocal = "Jazigo";

    protected override Task OnInitializedAsync()
    {
        DbContext = DbFactory.CreateDbContext();
        CalcularIsInfantil();
        _ultimoTipoLocal = tipoLocal;
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        // Se o usuário mudar o radio de tipo, limpa a seleção anterior (tipo incompatível)
        if (tipoLocal != _ultimoTipoLocal)
        {
            localSelecionado  = null;
            tipoLocalAlterado = true;
            _ultimoTipoLocal  = tipoLocal;
        }
    }

    /// <summary>Calcula se o falecido é infantil com base na DataNascimento vs DataFalecimento.</summary>
    private void CalcularIsInfantil()
    {
        if (!FalecidoDataNascimento.HasValue)
        {
            falecidoIsInfantil = false;
            return;
        }

        var nascimento  = FalecidoDataNascimento.Value.ToLocalTime();
        var falecimento = FalecidoDataFalecimento.ToLocalTime();

        // Cálculo preciso de anos completos
        int idade = falecimento.Year - nascimento.Year;
        if (falecimento < nascimento.AddYears(idade)) idade--;

        falecidoIsInfantil = idade <= 12;
    }

    private async Task AbrirMapaSelecao()
    {
        tipoLocalAlterado = false;

        var parameters = new DialogParameters
        {
            ["FalecidoIsInfantil"] = falecidoIsInfantil,
            ["TipoLocal"]          = tipoLocal
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth         = MaxWidth.Large,
            FullWidth        = true,
            CloseButton      = true
        };

        var dialog = await DialogService.ShowAsync<SelecionarLocalSepultamentoDialog>(
            "Selecionar Local de Sepultamento", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled &&
            result.Data is SelecionarLocalSepultamentoDialog.ResultadoSelecaoLocal selecionado)
        {
            localSelecionado = selecionado;
            tipoLocal        = selecionado.TipoLocal;
            _ultimoTipoLocal = tipoLocal;
            StateHasChanged();
        }
    }

    private void LimparLocal()
    {
        localSelecionado  = null;
        tipoLocalAlterado = false;
        StateHasChanged();
    }

    private async Task Confirmar()
    {
        await form.Validate();
        if (!form.IsValid) return;

        if (localSelecionado == null)
        {
            Snackbar.Add("Selecione um local de sepultamento no mapa.", Severity.Warning);
            return;
        }

        isLoading = true;
        StateHasChanged();

        using var transaction = await DbContext.Database.BeginTransactionAsync();
        try
        {
            var atendimento = await DbContext.Atendimentos
                .Include(a => a.Falecido)
                .FirstOrDefaultAsync(a => a.Id == AtendimentoId);

            if (atendimento == null || atendimento.Falecido == null)
            {
                Snackbar.Add("Registro de atendimento não encontrado.", Severity.Error);
                isLoading = false;
                StateHasChanged();
                return;
            }

            var falecido = atendimento.Falecido;

            // Garantir que a data seja salva como UTC
            var dataSep = dataSepultamento.HasValue
                ? DateTime.SpecifyKind(dataSepultamento.Value, DateTimeKind.Utc)
                : DateTime.UtcNow;

            atendimento.DataSepultamento    = dataSep;
            atendimento.HorarioSepultamento = horarioSepultamento;

            // ── Jazigo ────────────────────────────────────────────────────────
            if (localSelecionado.TipoLocal == "Jazigo")
            {
                if (!localSelecionado.JazigoId.HasValue)
                {
                    Snackbar.Add("Nenhum jazigo selecionado.", Severity.Error);
                    isLoading = false; StateHasChanged(); return;
                }

                var jazigo = await DbContext.Jazigos.FindAsync(localSelecionado.JazigoId.Value);
                if (jazigo == null)
                {
                    Snackbar.Add("Jazigo não encontrado.", Severity.Error);
                    isLoading = false; StateHasChanged(); return;
                }

                falecido.JazigoId = jazigo.Id;
                jazigo.Ocupado    = true;
                atendimento.LocalSepultamento = $"Jazigo {jazigo.CodigoIdentificador}";

                DbContext.Jazigos.Update(jazigo);
            }
            // ── Gaveta Pública ────────────────────────────────────────────────
            else if (localSelecionado.TipoLocal == "Gaveta")
            {
                if (!localSelecionado.GavetaId.HasValue)
                {
                    Snackbar.Add("Nenhuma gaveta selecionada.", Severity.Error);
                    isLoading = false; StateHasChanged(); return;
                }

                var gaveta = await DbContext.GavetasPublicas.FindAsync(localSelecionado.GavetaId.Value);
                if (gaveta == null || gaveta.Ocupada)
                {
                    Snackbar.Add("Gaveta não disponível.", Severity.Error);
                    isLoading = false; StateHasChanged(); return;
                }

                gaveta.Ocupada              = true;
                gaveta.FalecidoId           = falecido.Id;
                gaveta.DataOcupacao         = dataSep;
                gaveta.DataPrevisaoExumacao = dataSep.AddYears(anosPermanencia);
                atendimento.LocalSepultamento = $"Gaveta Pública {gaveta.NumeroGaveta}";

                DbContext.GavetasPublicas.Update(gaveta);
            }

            // Atualizar status do ciclo de vida do falecido
            falecido.Status = StatusFalecido.Sepultado;

            DbContext.Falecidos.Update(falecido);
            DbContext.Atendimentos.Update(atendimento);

            await DbContext.SaveChangesAsync();
            await transaction.CommitAsync();

            Snackbar.Add($"Sepultamento de {FalecidoNome} realizado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Snackbar.Add($"Erro ao realizar sepultamento: {ex.Message}", Severity.Error);
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
